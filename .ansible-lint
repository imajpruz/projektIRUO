# ansible-lint configuration
#
# Run with: ansible-lint ansible/

profile: basic

exclude_paths:
  # Generated by lib/render_inventory.py from terraform output, gitignored, and
  # not hand-maintained. Its long ProxyCommand line is deliberate.
  - ansible/inventory/
  - build/

skip_list:
  # var-naming[no-role-prefix] wants every variable inside a role to be
  # prefixed with that role's name, e.g. storage_azure_storage_account. These
  # variables are deliberately NOT role-scoped: the generated inventory sets
  # them once per host and several roles read the same value.
  #
  #   techsprint_cloud       read by common, storage, moodle and bastion
  #   azure_storage_*        set by the inventory, read by storage
  #   moodle_db_*            set by the inventory, read by database and moodle
  #   is_db_primary          set by the inventory, read by database and moodle
  #
  # Prefixing them per role would mean defining the same value under four
  # different names and keeping them in sync by hand, which is exactly the
  # class of bug the single generated inventory exists to prevent.
  - var-naming[no-role-prefix]
